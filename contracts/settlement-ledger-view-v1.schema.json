            },
            "payStage": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "money": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claimAmount",
            "payAmount",
            "claimAdjustment",
            "payAdjustment",
