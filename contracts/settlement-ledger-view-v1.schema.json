            "calculationBasis",
            "supplierFeeRaw",
            "channelFeeRaw"
          ],
          "properties": {
            "claimAmount": {
              "$ref": "#/$defs/nullableNumber"
            },
            "payAmount": {
              "$ref": "#/$defs/nullableNumber"
            },
            "claimAdjustment": {
              "$ref": "#/$defs/nullableNumber"
            },
            "payAdjustment": {
              "$ref": "#/$defs/nullableNumber"
            },
            "adjustmentReason": {
              "$ref": "#/$defs/nullableString"
            },
            "calculationBasis": {
              "$ref": "#/$defs/nullableString"
            },
            "supplierFeeRaw": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "channelFeeRaw": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "project",
            "collection",
            "documentId"
          ],
          "properties": {
            "authority": {
              "const": "FREEPASS_DATA_SETTLEMENT"
            },
            "project": {
              "const": "freepasserp5"
            },
            "collection": {
              "const": "settlement_rows"
            },
            "documentId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "moneyFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supply",
        "vat",
