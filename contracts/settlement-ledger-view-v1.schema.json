        },
        "sourceFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded",
        "written",
        "calculated",
        "confirmed",
        "cash",
        "audit",
        "evidence"
      ],
      "properties": {
        "recorded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim",
            "pay"
