            }
          }
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractDocumentReceived",
            "delivered",
            "deliveredAt",
            "cancelled",
            "billed",
            "billingMonth",
            "billedAt",
            "invoiceIssued",
            "invoiceAt",
            "collected",
            "collectedAmount",
            "paid",
            "paidAmount",
            "billingHold",
            "settlementExcluded",
            "claimStage",
            "payStage"
          ],
          "properties": {
            "contractDocumentReceived": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "delivered": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "deliveredAt": {
              "$ref": "#/$defs/nullableDate"
            },
            "cancelled": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "billed": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "billingMonth": {
              "$ref": "#/$defs/nullableString"
            },
            "billedAt": {
              "$ref": "#/$defs/nullableDate"
            },
            "invoiceIssued": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "invoiceAt": {
              "$ref": "#/$defs/nullableDate"
            },
            "collected": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "collectedAmount": {
              "$ref": "#/$defs/nullableNumber"
            },
            "paid": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "paidAmount": {
              "$ref": "#/$defs/nullableNumber"
            },
            "billingHold": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "settlementExcluded": {
              "$ref": "#/$defs/nullableBoolean"
            },
