{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/settlement-ledger-view-v1.schema.json",
  "title": "FreePass Data Settlement Ledger View V1 and opt-in V2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "data",
        "meta"
      ],
      "properties": {
        "schema": {
          "const": "freepass-data.settlement-ledger/v1"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumerId",
            "authority",
            "sourceProject",
            "sourceCollection",
            "observedAt",
            "count",
            "sourceDigest",
            "dataDigest"
          ],
          "properties": {
            "consumerId": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "const": "FREEPASS_DATA_SETTLEMENT"
            },
            "sourceProject": {
              "const": "freepasserp5"
            },
            "sourceCollection": {
              "const": "settlement_rows"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "sourceDigest": {
              "$ref": "#/$defs/digest"
            },
            "dataDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "data",
        "meta"
      ],
      "properties": {
        "schema": {
          "const": "freepass-data.settlement-ledger/v2"
        },
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recordV2"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consumerId",
            "authority",
            "sourceProject",
            "sourceCollection",
            "observedAt",
            "count",
            "sourceDigest",
            "dataDigest",
            "snapshotSummary"
          ],
          "properties": {
            "consumerId": {
              "type": "string",
              "minLength": 1
            },
            "authority": {
              "const": "FREEPASS_DATA_SETTLEMENT"
            },
            "sourceProject": {
              "const": "freepasserp5"
            },
            "sourceCollection": {
              "const": "settlement_rows"
            },
            "observedAt": {
              "type": "string",
              "format": "date-time"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "sourceDigest": {
              "$ref": "#/$defs/digest"
            },
            "dataDigest": {
              "$ref": "#/$defs/digest"
            },
            "snapshotSummary": {
              "$ref": "#/$defs/snapshotSummary"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerId",
        "identity",
        "contract",
        "parties",
        "progress",
        "money",
        "source"
      ],
      "properties": {
        "ledgerId": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vehicleNumber",
            "receivedAt"
          ],
          "properties": {
            "vehicleNumber": {
              "$ref": "#/$defs/nullableString"
            },
            "receivedAt": {
              "$ref": "#/$defs/nullableDate"
            }
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customerName",
            "model",
            "productKind",
            "paymentKind",
            "paidRounds"
          ],
          "properties": {
            "customerName": {
              "$ref": "#/$defs/nullableString"
            },
            "model": {
              "$ref": "#/$defs/nullableString"
            },
            "productKind": {
              "$ref": "#/$defs/nullableString"
            },
            "paymentKind": {
              "$ref": "#/$defs/nullableString"
            },
            "paidRounds": {
              "$ref": "#/$defs/nullableNumber"
            }
          }
        },
        "parties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supplierName",
            "supplierCode",
            "channelName",
            "channelCode",
            "agentName",
            "agentCode"
          ],
          "properties": {
            "supplierName": {
              "$ref": "#/$defs/nullableString"
            },
            "supplierCode": {
              "$ref": "#/$defs/nullableString"
            },
            "channelName": {
              "$ref": "#/$defs/nullableString"
            },
            "channelCode": {
              "$ref": "#/$defs/nullableString"
            },
            "agentName": {
              "$ref": "#/$defs/nullableString"
            },
            "agentCode": {
