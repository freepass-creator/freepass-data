              "$ref": "#/$defs/moneyFact"
            },
            "pay": {
              "$ref": "#/$defs/moneyFact"
            }
          }
        },
        "cash": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim",
            "pay",
            "verification",
            "eventsState",
            "eventsDigest",
            "events"
          ],
          "properties": {
            "claim": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "at",
                "reportedComplete"
              ],
              "properties": {
                "amount": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "at": {
                  "$ref": "#/$defs/nullableString"
                },
                "reportedComplete": {
                  "$ref": "#/$defs/nullableBoolean"
                }
              }
            },
            "pay": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "at",
                "reportedComplete"
              ],
              "properties": {
                "amount": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "at": {
                  "$ref": "#/$defs/nullableString"
                },
                "reportedComplete": {
                  "$ref": "#/$defs/nullableBoolean"
                }
              }
            },
            "verification": {
              "const": "RECORDED_UNVERIFIED"
            },
            "eventsState": {
              "enum": [
                "READ",
                "UNAVAILABLE",
                "LIMIT_REACHED",
                "IDENTITY_MISSING"
              ]
            },
            "eventsDigest": {
              "$ref": "#/$defs/nullableString"
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "axis",
                  "kind",
                  "amount",
                  "day",
                  "by",
                  "createdAt"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "axis": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "kind": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "amount": {
                    "$ref": "#/$defs/nullableNumber"
                  },
                  "day": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "by": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "createdAt": {
                    "$ref": "#/$defs/nullableTimestamp"
                  }
                }
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "createdBy",
            "updatedBy",
            "createdAt",
            "updatedAt",
            "businessDate",
            "historyState",
            "history",
            "historyDigest"
          ],
          "properties": {
            "createdBy": {
              "$ref": "#/$defs/nullableString"
            },
            "updatedBy": {
              "$ref": "#/$defs/nullableString"
            },
            "createdAt": {
              "$ref": "#/$defs/nullableTimestamp"
            },
            "updatedAt": {
              "$ref": "#/$defs/nullableTimestamp"
            },
            "businessDate": {
              "$ref": "#/$defs/nullableString"
            },
            "historyState": {
              "enum": [
                "IDENTITY_MISSING",
                "READ",
                "UNAVAILABLE"
              ]
            },
            "history": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "at",
                  "by",
                  "field",
                  "from",
                  "to"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "at": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "by": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "field": {
                    "$ref": "#/$defs/nullableString"
                  },
                  "from": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "to": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            },
            "historyDigest": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceDigest",
            "receiptRow",
            "syncedAt"
          ],
          "properties": {
            "sourceDigest": {
              "$ref": "#/$defs/nullableString"
            },
            "receiptRow": {
              "$ref": "#/$defs/nullableNumber"
            },
            "syncedAt": {
              "$ref": "#/$defs/nullableTimestamp"
            }
          }
        }
      }
    },
