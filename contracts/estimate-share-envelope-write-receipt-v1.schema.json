{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/estimate-share-envelope-write-receipt-v1.schema.json",
  "title": "FreePass Estimate Share Envelope write receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "envelopeId", "envelopeVersion", "snapshotHash", "idempotencyKey", "persistedAt"],
  "properties": {
    "contract": { "const": "freepass-share-envelope-write-receipt/v1" },
    "status": { "enum": ["CREATED", "EXISTING"] },
    "envelopeId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,200}$" },
    "envelopeVersion": { "const": 1 },
    "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "persistedAt": { "type": "string", "format": "date-time" }
  }
}
