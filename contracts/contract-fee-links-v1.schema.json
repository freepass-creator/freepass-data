{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/contract-fee-links-v1.schema.json",
  "title": "FreePass Data Contract Fee Links V1",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "supplierId",
              "termMonths",
              "monthlyRent"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^/\\u0000-\\u001f\\u007f]+$"
              },
              "plate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "supplierId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "termMonths": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "monthlyRent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "deposit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            }
          }
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "const": "KRW"
        }
      }
    },
    "feeAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "state",
        "amount",
        "vatTreatment",
        "vatAmount",
        "totalAmount",
        "reasonCode",
        "ruleId",
        "policyId",
        "sourceRefs"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFIRMED",
            "UNCONFIRMED"
          ]
        },
        "state": {
          "enum": [
            "KNOWN",
            "ZERO",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/money"
            },
            {
              "type": "null"
            }
          ]
        },
        "vatTreatment": {
          "type": [
            "string",
            "null"
          ]
        },
        "vatAmount": {
          "type": [
            "number",
            "null"
          ]
        },
        "totalAmount": {
          "type": [
            "number",
            "null"
          ]
        },
        "reasonCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "policyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "results"
      ],
      "properties": {
        "contract": {
          "const": "contract-fee-links/v1"
        },
        "results": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "key",
              "status"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "LINKED",
                  "FEE_UNCONFIRMED",
                  "FAILED"
                ]
              },
              "failure": {
                "enum": [
                  "NO_PLATE",
                  "NO_ASSET",
                  "MULTI_ASSET",
                  "NO_PRODUCT",
                  "MULTI_PRODUCT",
                  "NO_OFFER",
                  "MULTI_OFFER",
                  "SUPPLIER_MISMATCH",
                  "NO_TERM",
                  "CONDITION_MISMATCH",
                  "MULTI_TERM"
                ]
              },
              "fees": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "termKey",
                  "termMonths",
                  "supplierBillingFee",
                  "channelPayoutFee"
                ],
                "properties": {
                  "termKey": {
                    "type": "string"
                  },
                  "termMonths": {
                    "type": "integer"
                  },
                  "supplierBillingFee": {
                    "$ref": "#/$defs/feeAmount"
                  },
                  "channelPayoutFee": {
                    "$ref": "#/$defs/feeAmount"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
