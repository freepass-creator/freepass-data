{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/erp-public-view-v1.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["productId", "productRevision", "vehicleModelId", "displayName", "commercialType", "vehicle", "offers"],
    "properties": {
      "productId": {"type": "string", "minLength": 1},
      "productRevision": {"type": "integer", "minimum": 1},
      "vehicleModelId": {"type": "string", "minLength": 1},
      "vehicleAssetId": {"type": ["string", "null"]},
      "displayName": {"type": "string", "minLength": 1},
      "commercialType": {"enum": ["NEW_RENT", "USED_RENT", "NEW_SUBSCRIPTION", "USED_SUBSCRIPTION", "PICKUP_SUBSCRIPTION"]},
      "vehicle": {
        "type": "object", "additionalProperties": false, "required": ["maker", "model"],
        "properties": {
          "maker": {"type": "string"}, "model": {"type": "string"},
          "generation": {"type": ["string", "null"]}, "subModel": {"type": ["string", "null"]},
          "trim": {"type": ["string", "null"]}, "fuel": {"type": ["string", "null"]},
          "drive": {"type": ["string", "null"]}, "seats": {"type": ["integer", "null"], "minimum": 1},
          "assetStatus": {"enum": ["AVAILABLE", "RESERVED", "IN_USE", "RETURNED", "MAINTENANCE", "ACCIDENT", "SOLD", "RETIRED", null]},
          "plateNumber": {"type": ["string", "null"]}, "odometerKm": {"type": ["integer", "null"], "minimum": 0}
        }
      },
      "offers": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["offerId", "supplierId", "offerRevision", "priceTerms"],
          "properties": {
            "offerId": {"type": "string", "minLength": 1}, "supplierId": {"type": "string", "minLength": 1},
            "offerRevision": {"type": "integer", "minimum": 1}, "policyId": {"type": ["string", "null"]},
            "priceTerms": {"type": "array", "minItems": 1, "items": {"$ref": "https://freepass.teamjpk.com/contracts/catalog-v1.schema.json#/$defs/priceTerm"}}
          }
        }
      }
    }
  }
}
