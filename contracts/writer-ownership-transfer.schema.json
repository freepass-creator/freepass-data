{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/writer-ownership-transfer.schema.json",
  "title": "TransferCatalogWriterOwnershipCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "idempotencyKey",
    "expectedRevision",
    "toWriterId",
    "actor",
    "reason"
  ],
  "properties": {
    "commandId": {"type": "string", "minLength": 1},
    "idempotencyKey": {"type": "string", "minLength": 8},
    "expectedRevision": {"type": "integer", "minimum": 0},
    "toWriterId": {"const": "service:freepass-data"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["USER", "SERVICE"]},
        "organizationId": {"type": ["string", "null"]}
      }
    },
    "reason": {"type": "string", "minLength": 2}
  }
}
