{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/internal-ai-reference-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "data", "commissionPolicy", "meta"],
  "properties": {
    "schema": { "const": "freepass-data.internal-ai-reference/v1" },
    "data": { "$ref": "https://freepass.teamjpk.com/contracts/kakao-catalog-reference-v1.schema.json#/properties/data" },
    "commissionPolicy": { "$ref": "https://freepass.teamjpk.com/contracts/kakao-catalog-reference-v1.schema.json#/properties/commissionPolicy" },
    "meta": {
      "type": "object", "additionalProperties": false,
      "required": ["consumerId", "projectionId", "authority", "publicationDecision", "observedAt", "sourceProject", "sourceCollection", "sourceCount", "projectedCount", "dataDigest", "warning"],
      "properties": {
        "consumerId": { "type": "string", "pattern": "^internal-ai-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "projectionId": { "const": "internal-ai-reference" },
        "authority": { "const": "REFERENCE_ONLY" },
        "publicationDecision": { "const": "HOLD" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceProject": { "const": "freepasserp5" },
        "sourceCollection": { "const": "products" },
        "sourceScope": { "const": "COLLECTED" },
        "sourceCount": { "type": "integer", "minimum": 1 },
        "projectedCount": { "type": "integer", "minimum": 0 },
        "depositFilter": { "$ref": "https://freepass.teamjpk.com/contracts/kakao-catalog-reference-v1.schema.json#/$defs/depositFilter" },
        "queryFilter": {"type":"object","additionalProperties":false,"minProperties":1,"properties":{"supplierId":{"type":"string","minLength":1},"supplierName":{"type":"string","minLength":1},"plateNumber":{"type":"string","minLength":1},"maker":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"commercialType":{"type":"string","minLength":1},"assetStatus":{"type":"string","minLength":1},"termMonths":{"type":"string","minLength":1},"mileageKm":{"type":"string","minLength":1},"monthlyRentMin":{"type":"string","minLength":1},"monthlyRentMax":{"type":"string","minLength":1},"depositMin":{"type":"string","minLength":1},"depositMax":{"type":"string","minLength":1},"mileagePeriod":{"type":"string","minLength":1},"depositState":{"type":"string","minLength":1},"depositScope":{"type":"string","minLength":1},"sourceScope":{"enum":["LISTABLE","COLLECTED"]}}},
    "queryResolution": {"type": "object", "additionalProperties": false, "required": ["state", "reasonCode", "matchedProductCount"], "properties": {"state": {"enum": ["HOLD", "MATCHED", "NO_MATCH"]}, "reasonCode": {"enum": ["SUPPLIER_NAME_MULTIPLE_CODES", "PLATE_MULTIPLE_PRODUCTS", null]}, "matchedProductCount": {"type": "integer", "minimum": 0}}},
        "dataDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "warning": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [{ "$ref": "https://freepass.teamjpk.com/contracts/kakao-catalog-reference-v1.schema.json#/allOf/0" }]
}
