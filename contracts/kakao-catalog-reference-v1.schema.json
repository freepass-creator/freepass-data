        "listable": { "type": ["boolean", "null"] }, "status": { "type": ["string", "null"] }, "deleted": { "type": "boolean" },
        "supplierId": { "type": ["string", "null"] }, "supplierName": { "type": ["string", "null"] }, "sourceRef": { "type": "string", "minLength": 1 },
        "conditionState": { "enum": ["REFERENCE", "HOLD"] }, "reasonCode": { "type": ["string", "null"] },
        "priceConditions": { "type": "array", "items": {
