{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/kakao-catalog-reference-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "data", "commissionPolicy", "meta"],
  "properties": {
    "schema": { "const": "freepass-data.kakao-catalog-reference/v1" },
    "data": {
      "type": "array",
      "minItems": 0,
      "items": { "$ref": "#/$defs/product" }
    },
    "commissionPolicy": { "$ref": "#/$defs/commissionPolicy" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumerId", "projectionId", "authority", "publicationDecision", "observedAt", "sourceProject", "sourceCollection", "sourceCount", "projectedCount", "dataDigest", "warning"],
      "properties": {
        "consumerId": { "const": "kakao-ops" },
        "projectionId": { "const": "kakao-catalog-reference" },
        "authority": { "const": "REFERENCE_ONLY" },
        "publicationDecision": { "const": "HOLD" },
        "observedAt": { "type": "string", "format": "date-time" },
        "sourceProject": { "const": "freepasserp5" },
        "sourceCollection": { "const": "products" },
        "sourceCount": { "type": "integer", "minimum": 1 },
        "projectedCount": { "type": "integer", "minimum": 0 },
    "depositFilter": { "$ref": "#/$defs/depositFilter" },
    "queryFilter": {"type":"object","additionalProperties":false,"minProperties":1,"properties":{"supplierId": {"type": "string", "minLength": 1}, "supplierName": {"type": "string", "minLength": 1}, "plateNumber": {"type": "string", "minLength": 1}, "maker": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "commercialType": {"type": "string", "minLength": 1}, "assetStatus": {"type": "string", "minLength": 1}, "termMonths": {"type": "string", "minLength": 1}, "mileageKm": {"type": "string", "minLength": 1}, "monthlyRentMin": {"type": "string", "minLength": 1}, "monthlyRentMax": {"type": "string", "minLength": 1}, "depositMin": {"type": "string", "minLength": 1}, "depositMax": {"type": "string", "minLength": 1}, "mileagePeriod": {"type": "string", "minLength": 1}, "depositState": {"type": "string", "minLength": 1}, "depositScope": {"type": "string", "minLength": 1}}},
    "queryResolution": {"type": "object", "additionalProperties": false, "required": ["state", "reasonCode", "matchedProductCount"], "properties": {"state": {"enum": ["HOLD", "MATCHED", "NO_MATCH"]}, "reasonCode": {"enum": ["SUPPLIER_NAME_MULTIPLE_CODES", "PLATE_MULTIPLE_PRODUCTS", null]}, "matchedProductCount": {"type": "integer", "minimum": 0}}},
        "dataDigest": { "$ref": "#/$defs/digest" },
        "warning": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "vehicleMasterReference": {"type": "object", "additionalProperties": false, "required": ["state", "authority", "identityKind", "masterId", "trimId", "snapshotDigest", "readAt", "reasonCode"], "properties": {"state": {"enum": ["KNOWN", "HOLD"]}, "authority": {"const": "FREEPASS_DATA_VEHICLE_MASTER"}, "identityKind": {"const": "FIRESTORE_DOCUMENT_ID"}, "masterId": {"type": ["string", "null"], "minLength": 1}, "trimId": {"type": ["string", "null"], "minLength": 1}, "snapshotDigest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "readAt": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}, "reasonCode": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"state": {"const": "KNOWN"}}}, "then": {"properties": {"masterId": {"type": "string"}, "trimId": {"type": "string"}, "snapshotDigest": {"type": "string"}, "readAt": {"type": "string", "format": "date-time"}, "reasonCode": {"type": "null"}}}, "else": {"properties": {"masterId": {"type": "null"}, "trimId": {"type": "null"}, "reasonCode": {"type": "string", "minLength": 1}}}}]},
    "depositFilter": {"type": "object", "additionalProperties": false, "required": ["state", "termMonths", "scope"], "properties": {"state": {"const": "ZERO"}, "termMonths": {"type": ["integer", "null"], "minimum": 1, "maximum": 60}, "scope": {"enum": ["ANY_TERM", "ALL_TERMS"]}}},
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableString": { "type": ["string", "null"] },
    "nullableInteger": { "type": ["integer", "null"], "minimum": 0 },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "integer", "minimum": 0 },
        "currency": { "const": "KRW" }
      }
    },
    "commissionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "ruleId", "amount", "vatTreatment", "vatAmount", "totalAmount", "reasonCode"],
      "properties": {
        "state": { "enum": ["CALCULATED", "COORDINATION_REQUIRED", "UNKNOWN", "NOT_APPLICABLE"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(F04:수수료표!A[1-9][0-9]*:M[1-9][0-9]*|USER:2026-10-09:BILLIN_LC_36_MONTH_RENT_100_80)$" } },
        "ruleId": { "$ref": "#/$defs/nullableString" },
        "amount": { "$ref": "#/$defs/nullableInteger" },
        "vatTreatment": { "enum": ["EXCLUDED", "INCLUDED", "UNKNOWN"] },
        "vatAmount": { "$ref": "#/$defs/nullableInteger" },
        "totalAmount": { "$ref": "#/$defs/nullableInteger" },
        "reasonCode": { "$ref": "#/$defs/nullableString" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "CALCULATED" } }, "required": ["state"] }, "then": { "properties": { "sourceRefs": { "type": "array", "minItems": 1 } }, "required": ["sourceRefs"] } },
        { "if": { "properties": { "state": { "enum": ["UNKNOWN", "NOT_APPLICABLE", "COORDINATION_REQUIRED"] } }, "required": ["state"] }, "then": { "properties": { "sourceRefs": false } } }
      ]
    },
    "marginResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "amount", "currency", "basis", "reasonCode"],
      "properties": {
        "state": { "enum": ["CALCULATED", "UNKNOWN", "NOT_APPLICABLE"] },
        "amount": { "type": ["integer", "null"] },
        "currency": { "const": "KRW" },
        "basis": { "const": "SUPPLY_AMOUNT_EXCLUDING_VAT" },
        "reasonCode": { "$ref": "#/$defs/nullableString" }
      }
    },
    "priceTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["termKey", "termMonths", "monthlyRent", "deposit", "depositAmount", "depositState", "depositRule", "mileageLimitKmPerYear", "settlement", "salesCommission", "supplierBillingFee", "channelPayoutFee", "expectedGrossMargin"],
      "properties": {
        "termKey": { "type": "string", "minLength": 1 },
        "termMonths": { "type": "integer", "minimum": 1 },
        "monthlyRent": { "$ref": "#/$defs/money" },
        "deposit": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/money" }] },
        "depositAmount": { "$ref": "#/$defs/nullableInteger" },
        "depositEvidence": {"type": "object", "additionalProperties": false, "required": ["sourceRef", "sourceAmount", "sourceNote", "reasonCode"], "properties": {"sourceRef": {"type": "string", "minLength": 1}, "sourceAmount": {"type": ["number", "string", "null"]}, "sourceNote": {"type": ["string", "null"]}, "reasonCode": {"type": "string", "minLength": 1}}},
        "depositState": { "enum": ["KNOWN", "ZERO", "UNKNOWN"] },
        "depositStatusLabel": { "enum": ["보증금 있음", "무보증", "미확인", "보증금 확인 필요"] },
        "depositRule": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "multiplier", "label"],
              "properties": {
                "code": { "enum": ["RENT_X_CONTRACT_YEARS_MAX3", "RENT_X_2", "IMPORT_12_X3_18_PLUS_X6", "ZERO_DEPOSIT", "SOURCE_AMOUNT", "IANCAR_PUBLISHED_CONDITION_EVIDENCE"] },
                "multiplier": { "type": ["integer", "null"], "minimum": 0 },
                "label": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "contractedMileage": { "type": "object", "additionalProperties": false, "required": ["km", "period"], "properties": { "km": { "type": "integer", "minimum": 1 }, "period": { "enum": ["year", "month"] } } },
        "mileageLimitKmPerYear": { "$ref": "#/$defs/nullableInteger" },
        "settlement": { "enum": ["RETURN", "BUYOUT"] },
        "salesCommission": { "$ref": "#/$defs/commissionResolution" },
        "supplierBillingFee": { "$ref": "#/$defs/commissionResolution" },
        "channelPayoutFee": { "$ref": "#/$defs/commissionResolution" },
        "expectedGrossMargin": { "$ref": "#/$defs/marginResolution" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "sourceProductId", "displayName", "commercialType", "vehicleModelId", "vehicleAssetId", "vehicle", "shadowFacts", "offers"],
      "properties": {
        "productId": { "type": "string", "minLength": 1 },
        "sourceProductId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "commercialType": { "enum": ["NEW_RENT", "USED_RENT", "NEW_SUBSCRIPTION", "USED_SUBSCRIPTION", "OGONG_SUBSCRIPTION", "PICKUP_SUBSCRIPTION", "OPLUS_SUBSCRIPTION", "UNKNOWN"] },
        "vehicleMasterReference": { "$ref": "#/$defs/vehicleMasterReference" },
        "vehicleModelId": { "type": "string", "minLength": 1 },
        "vehicleAssetId": { "type": "string", "minLength": 1 },
        "vehicleMediaEvidence": {"type": "object", "additionalProperties": false, "required": ["productKeyDigest", "observedAt", "verdict", "issues", "photoState", "colorState", "checks", "typedColorVerification", "visualVehicleIdentity", "imageBytes", "consumerReadback"], "properties": {"productKeyDigest": {"$ref": "#/$defs/digest"}, "observedAt": {"type": "string", "format": "date-time"}, "verdict": {"enum": ["HOLD", "HEAD_AND_SOURCE_FIELDS_MATCHED"]}, "issues": {"type": "array", "items": {"type": "string"}}, "photoState": {"enum": ["URLS_PRESENT", "LINK_ONLY", "UNUSABLE", "NOT_PROVIDED"]}, "colorState": {"enum": ["NOT_PROVIDED", "SOURCE_COMPARISON_ATTEMPTED", "VALUE_PRESENT_SOURCE_UNVERIFIED"]}, "checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["urlDigest", "state", "status"], "properties": {"urlDigest": {"$ref": "#/$defs/digest"}, "state": {"type": "string"}, "status": {"type": ["integer", "null"]}}}}, "typedColorVerification": {"const": "NOT_CHECKED"}, "visualVehicleIdentity": {"const": "NOT_CHECKED"}, "imageBytes": {"const": "NOT_CHECKED"}, "consumerReadback": {"const": "NOT_CHECKED"}}},
        "vehiclePhotos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "imageUrls", "representativeUrl", "sourceLinkCount", "rejectedCount", "accessVerification"],
          "properties": {
            "state": { "enum": ["URLS_PRESENT", "LINK_ONLY", "UNUSABLE", "NOT_PROVIDED"] },
            "imageUrls": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri", "pattern": "^https://" } },
            "representativeUrl": { "type": ["string", "null"], "format": "uri", "pattern": "^https://" },
            "sourceLinkCount": { "type": "integer", "minimum": 0 },
            "rejectedCount": { "type": "integer", "minimum": 0 },
            "accessVerification": { "const": "NOT_CHECKED" }
          }
        },
        "vehicle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maker", "model", "subModel", "trim", "fuel", "drive", "seats", "assetStatus", "plateNumber", "odometerKm", "exteriorColor"],
          "properties": {
            "maker": { "type": "string" },
            "model": { "type": "string" },
            "subModel": { "$ref": "#/$defs/nullableString" },
            "trim": { "$ref": "#/$defs/nullableString" },
            "fuel": { "$ref": "#/$defs/nullableString" },
            "drive": { "$ref": "#/$defs/nullableString" },
            "seats": { "$ref": "#/$defs/nullableInteger" },
            "assetStatus": { "enum": ["AVAILABLE", "RESERVED", "MAINTENANCE", null] },
            "plateNumber": { "$ref": "#/$defs/nullableString" },
            "odometerKm": { "$ref": "#/$defs/nullableInteger" },
            "exteriorColor": { "$ref": "#/$defs/nullableString" }
          }
        },
        "shadowFacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modelYear", "options", "depositNote", "vehicleStatus"],
          "properties": {
            "modelYear": { "$ref": "#/$defs/nullableInteger" },
            "options": { "$ref": "#/$defs/nullableString" },
            "depositNote": { "$ref": "#/$defs/nullableString" },
            "vehicleStatus": { "$ref": "#/$defs/nullableString" }
          }
        },
        "offers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["offerId", "supplierId", "supplierName", "policyId", "policyContext", "priceTerms"],
            "properties": {
              "offerId": { "type": "string", "minLength": 1 },
              "supplierId": { "type": "string", "minLength": 1 },
              "supplierName": { "$ref": "#/$defs/nullableString" },
              "policyId": { "$ref": "#/$defs/nullableString" },
              "policyContext": {
                "type": "object", "additionalProperties": false,
                "required": ["state", "policyId", "sourceRef", "facts", "reasonCode"],
                "properties": {
                  "state": { "enum": ["REFERENCE", "UNKNOWN"] },
                  "policyId": { "$ref": "#/$defs/nullableString" },
                  "sourceRef": { "$ref": "#/$defs/nullableString" },
                  "reasonCode": { "$ref": "#/$defs/nullableString" },
                  "facts": { "type": "array", "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["key", "label", "value", "sourceRef"],
                    "properties": {
                      "key": { "type": "string", "minLength": 1 },
                      "label": { "type": "string", "minLength": 1 },
                      "sourceRef": { "type": "string", "minLength": 1 },
                      "value": { "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "array", "items": { "type": "string" } }] }
                    }
                  } }
                }
              },
              "priceTerms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/priceTerm" } }
            }
          }
        }
      }
    },
    "commissionPolicy": {
      "type": "object",
      "required": ["policyId", "sourceRole", "sourceObservedAt", "canonicalSource", "sourceFiles", "standardSupplierIds", "exceptionSupplierIds", "rules", "timingRules", "digest"],
      "properties": {
        "policyId": { "enum": ["sales-commission-2026-10-03", "sales-commission-2026-10-04", "sales-commission-2026-10-05", "sales-commission-2026-10-09"] },
        "sourceRole": { "enum": ["REPOSITORY_SSOT_WITH_GOOGLE_SHEET_COPY", "F04_GOOGLE_SHEET_SSOT"] },
        "sourceObservedAt": { "type": "string", "anyOf": [{ "format": "date-time" }, { "format": "date" }] },
        "canonicalSource": {
          "oneOf": [{
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "path", "revision"],
          "properties": {
            "repository": { "const": "freepass-creator/freepasserp4" },
            "path": { "const": "lib/domain/settlement-fee-table.ts" },
            "revision": { "type": "string", "minLength": 1 }
          }
          }, {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "range", "observedDate"],
            "properties": {
              "code": { "const": "F04" },
              "range": { "const": "수수료표!A1:M191" },
              "observedDate": { "type": "string", "format": "date" }
            }
          }]
        },
        "sourceFiles": { "type": "array", "minItems": 1, "maxItems": 1 },
        "standardSupplierIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exceptionSupplierIds": { "type": "object" },
        "rules": { "type": "array", "minItems": 1 },
        "timingRules": { "type": "array", "minItems": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
