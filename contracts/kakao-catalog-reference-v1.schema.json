          "required": ["sourceKey", "sourceRef", "termMonths", "monthlyRentSourceValue", "depositSourceValue", "contractedMileage", "monthlyRentAmount", "monthlyRentState", "depositAmount", "depositState", "supplierBillingFee", "channelPayoutFee", "state", "reasonCode"],
          "properties": {
