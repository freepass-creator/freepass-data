":{"type":"object","additionalProperties":false,"required":["termMonths","monthlyRent","deposit"],"properties":{"termMonths":{"type":"integer"},"monthlyRent":{"type":["string","number","null"]},"deposit":{"type":["string","number","null"]}}}}}},"normalized":{"type":"object","additionalProperties":false,"required":["supplierId","plateNumber","status","maker","model","subModel","trim","commercialType","priceConditions"],"properties":{"supplierId":{"type":["string","null"]},"plateNumber":{"type":["string","null"]},"status":{"type":["string","null"]},"maker":{"type":["string","null"]},"model":{"type":["string","null"]},"subModel":{"type":["string","null"]},"trim":{"type":["string","null"]},"commercialType":{"type":["string","null"]},"priceConditions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["termMonths","monthlyRentAmount","monthlyRentState","depositAmount","depositState","mileageKm","mileagePeriod"],"properties":{"termMonths":{"type":"integer"},"monthlyRentAmount":{"type":["integer","null"],"minimum":0},"monthlyRentState":{"enum":["KNOWN","UNKNOWN"]},"depositAmount":{"type":["integer","null"],"minimum":0},"depositState":{"enum":["KNOWN","ZERO","UNKNOWN"]},"mileageKm":{"type":["integer","null"],"minimum":0},"mileagePeriod":{"enum":["year",null]},"supplierBillingFee":{"$ref":"#/$defs/commissionResolution"},"channelPayoutFee":{"$ref":"#/$defs/commissionResolution"},"expectedGrossMargin":{"$ref":"#/$defs/marginResolution"},"priceSourceRefs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceRowProduct/properties/facts/items/properties/sourceRef"}}},"dependentRequired":{"supplierBillingFee":["channelPayoutFee","expectedGrossMargin","priceSourceRefs"],"channelPayoutFee":["supplierBillingFee","expectedGrossMargin","priceSourceRefs"],"expectedGrossMargin":["supplierBillingFee","channelPayoutFee","priceSourceRefs"],"priceSourceRefs":["supplierBillingFee","channelPayoutFee","expectedGrossMargin"]}}}}},"facts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["fieldKey","rawValue","normalizedValue","state","reasons","sourceRef"],"properties":{"fieldKey":{"type":"string"},"rawValue":{"type":["string","number","null"]},"normalizedValue":{"type":["string","number","null"]},"state":{"enum":["KNOWN","ZERO","HOLD","UNKNOWN"]},"reasons":{"type":"array","items":{"type":"string","pattern":"^[A-Z][A-Z0-9_:.-]{0,199}$"}},"sourceRef":{"type":"object","additionalProperties":false,"required":["runId","rawRecordId","row","field"],"properties":{"runId":{"type":"string"},"rawRecordId":{"type":"string"},"row":{"type":["integer","null"],"minimum":1},"field":{"type":"string"}}}}}},"representationKind":{"const":"CURRENT_SOURCE_ROW_PRODUCT"}}},
    "sourceRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "publicationDecision", "listable", "status", "deleted", "supplierId", "supplierName", "sourceRef", "conditionState", "reasonCode", "priceConditions"],
      "properties": {
