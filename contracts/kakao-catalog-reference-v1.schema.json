    "depositFilter": {"type": "object", "additionalProperties": false, "required": ["state", "termMonths", "scope"], "properties": {"state": {"const": "ZERO"}, "termMonths": {"type": ["integer", "null"], "minimum": 1, "maximum": 60}, "scope": {"enum": ["ANY_TERM", "ALL_TERMS"]}}},
