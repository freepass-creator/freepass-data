        "depositEvidence": {"type": "object", "additionalProperties": false, "required": ["sourceRef", "sourceAmount", "sourceNote", "reasonCode"], "dependentRequired": {"publicationEvidenceReason": ["publicationDecision"], "publicationDecision": ["publicationEvidenceReason"]}, "properties": {"sourceRef": {"type": "string", "minLength": 1}, "sourceAmount": {"type": ["number", "string", "null"]}, "sourceNote": {"type": ["string", "null"]}, "reasonCode": {"type": "string", "minLength": 1}, "publicationEvidenceReason": {"const": "IANCAR_PUBLISHED_DEPOSIT_EVIDENCE_STALE"}, "publicationDecision": {"const": "HOLD"}}},
        "depositState": { "enum": ["KNOWN", "ZERO", "UNKNOWN"] },
