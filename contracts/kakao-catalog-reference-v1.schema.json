            "supplierBillingFee": { "$ref": "#/$defs/commissionResolution" }, "channelPayoutFee": { "$ref": "#/$defs/commissionResolution" },
            "state": { "enum": ["REFERENCE", "HOLD"] }, "reasonCode": { "type": ["string", "null"] }
