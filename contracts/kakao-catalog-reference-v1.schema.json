    "sourceObservations": {"type":"object","additionalProperties":false,"required":["state","reasonCode","sourceSnapshot"],"properties":{"state":{"const":"HOLD"},"reasonCode":{"type":"string"},"sourceSnapshot":{"anyOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["sourceId","runId","observedAt","headStatus","coverageMode","completeness","countScope","rawRowCount","normalizedCandidateCount","currentProductRowCount","returnedProductRowCount","observedTabCounts","unobservedRegisteredTabs"],"properties":{"sourceId":{"type":"string"},"runId":{"type":"string"},"observedAt":{"type":"string","format":"date-time"},"headStatus":{"const":"CURRENT"},"coverageMode":{"enum":["FULL","DELTA","PARTIAL","UNKNOWN"]},"completeness":{"enum":["COMPLETE","INCOMPLETE","UNKNOWN"]},"countScope":{"const":"CAPTURED_SOURCE_PRODUCT_ROWS_NOT_PHYSICAL_VEHICLES"},"rawRowCount":{"type":"integer","minimum":0},"normalizedCandidateCount":{"type":"integer","minimum":0},"currentProductRowCount":{"type":"integer","minimum":0},"returnedProductRowCount":{"type":"integer","minimum":0},"observedTabCounts":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},"unobservedRegisteredTabs":{"type":"array","items":{"type":"string"}}}}]}}},
