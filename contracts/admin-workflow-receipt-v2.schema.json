{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freepass.teamjpk.com/contracts/admin-workflow-receipt-v2.schema.json",
  "title": "FreePass Data Admin workflow execution receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authority",
    "authorityRole",
    "semanticOwners",
    "consumerId",
    "operationId",
    "requestDigest",
    "mutationCount",
    "committedAt",
    "receiptDigest",
    "idempotent"
  ],
  "properties": {
    "schema": { "const": "freepass-data.admin-workflow-receipt/v2" },
    "authority": { "const": "FREEPASS_DATA_ACCESS_GATEWAY" },
    "authorityRole": { "const": "EXECUTION_GATEWAY" },
    "semanticOwners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FREEPASS_DATA_CATALOG",
          "FREEPASS_DATA_SETTLEMENT",
          "FREEPASS_DATA_REFERENCE",
          "FREEPASS_ADMIN_APPLICATION_CONTRACT"
        ]
      }
    },
    "consumerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operationId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mutationCount": { "type": "integer", "minimum": 1, "maximum": 128 },
    "committedAt": { "type": "string", "format": "date-time" },
    "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "idempotent": { "type": "boolean" }
  }
}
