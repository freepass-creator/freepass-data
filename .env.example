FREEPASS_DATA_DRIVER=memory
PORT=8787

# Target FreePass Data Firebase project. No default is intentionally provided.
# FIREBASE_PROJECT_ID=<target-freepass-data-project-id>

# Confirmed legacy source project binding from freepasserp4.
# Explicitly set this before a live read so the operator sees the boundary.
# LEGACY_FREEPASSERP3_PROJECT_ID=freepasserp3

# Credential must have only the permissions required for the selected operation.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json


# FreePass Admin Catalog consumer API.
# Production fails closed when this token is not configured.
# FREEPASS_DATA_ADMIN_VIEW_TOKEN=<service-bearer-token>
