FREEPASS_DATA_DRIVER=memory
PORT=8787

# Central FreePass Data Firestore target for the authenticated read runtime.
# Production read runtime requires this exact project ID.
FIREBASE_PROJECT_ID=freepasserp5
# Required when archiving vehicle-master source PDF/catalog/image bytes.
FIREBASE_STORAGE_BUCKET=<your-firebase-storage-bucket>

# Dedicated read-only consumer server.
# capabilities omitted => ["catalog"].
# Add "catalog-health" explicitly only for a backend that may read Data Health.
# Keep tokens in Secret Manager / workload secret storage, never browser code.
# ERP/white-label catalog example:
# FREEPASS_DATA_CONSUMERS_JSON=[{"id":"erp-com","projectionId":"erp-public","token":"<unique-random-service-secret-at-least-32-characters>","capabilities":["catalog","catalog-health"]}]
#
# Estimate master example (use a distinct token; do not share the ERP credential):
# FREEPASS_DATA_CONSUMERS_JSON=[{"id":"freepass-estimate","projectionId":"estimate-newcar-master","token":"<different-random-service-secret-at-least-32-characters>","capabilities":["estimate-newcar-master"]}]

# Credential must have only the read permissions required by this runtime.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/read-only-service-account.json


# Vehicle Master source capture
# Explicitly allow only reviewed public source hosts. Subdomains of each entry are allowed.
# Example:
# VEHICLE_MASTER_SOURCE_HOSTS=kia.com,hyundai.com,carnoon.co.kr,auto.danawa.com,mauto.danawa.com,carisyou.com
VEHICLE_MASTER_SOURCE_HOSTS=
# VEHICLE_MASTER_SOURCE_MAX_BYTES=26214400
# VEHICLE_MASTER_SOURCE_TIMEOUT_MS=20000


# Explicit Canonical vehicle-master promotion. Never enable by default.
# VEHICLE_MASTER_PROMOTION_APPROVED=true
# VEHICLE_MASTER_PROMOTION_JSON={"approval":"PROMOTE_CANONICAL","sourceDocumentIds":["..."],"anchor":{"makeId":"...","modelId":"...","generationId":"...","phaseId":"..."},"selector":{"modelYear":2027,"trimName":"프레스티지","powertrainName":"2.5 가솔린 터보","seats":5,"drivetrain":"2WD","basePrice":36410000}}


# Vehicle Master recent-first backfill
# Writes only source archive / SourceDocument / hash / RAW+NORMALIZED evidence.
# It does NOT promote Canonical Vehicle Master.
# VEHICLE_MASTER_BACKFILL_APPROVED=true
# VEHICLE_MASTER_BACKFILL_SOURCES=CARNOON,DANAWA,CARISYOU
# VEHICLE_MASTER_BACKFILL_BATCH_SIZE=20
# Maximum inventory/list pages followed in one run (brand shards included):
# VEHICLE_MASTER_BACKFILL_DISCOVERY_PAGE_LIMIT=100
# Optional stable observation time for a resumable campaign:
# VEHICLE_MASTER_BACKFILL_OBSERVED_AT=2026-09-25T14:00:00.000Z
# Pass URLs already completed by the external runner to skip them:
# VEHICLE_MASTER_BACKFILL_COMPLETED_URLS_JSON=[]
# Manufacturer pages or other reviewed URLs can be injected explicitly:
# VEHICLE_MASTER_BACKFILL_EXTRA_URLS_JSON=[{"sourceKey":"MANUFACTURER","sourceUrl":"https://www.kia.com/kr/vehicles/sorento/price","modelHint":"쏘렌토","latestModelYearHint":2027,"currentHint":true}]
