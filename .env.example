FREEPASS_DATA_DRIVER=memory
PORT=8787

# Central FreePass Data Firestore target for the authenticated read runtime.
# Production read runtime requires this exact project ID.
FIREBASE_PROJECT_ID=freepasserp5

# Dedicated read-only consumer server.
# capabilities omitted => ["catalog"].
# Add "catalog-health" explicitly only for a backend that may read Data Health.
# Keep tokens in Secret Manager / workload secret storage, never browser code.
# FREEPASS_DATA_CONSUMERS_JSON=[{"id":"erp-com","projectionId":"erp-public","token":"<unique-random-service-secret-at-least-32-characters>","capabilities":["catalog","catalog-health"]}]

# Credential must have only the read permissions required by this runtime.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/read-only-service-account.json
