FREEPASS_DATA_DRIVER=memory
PORT=8787

# User-confirmed central Firestore project. Memory remains the local demo default.
FIREBASE_PROJECT_ID=freepasserp5

# Dedicated read-only consumer server. Keep service credentials in the server secret store.
# Registered IDs: erp-com, whitelabel-<slug>. Unique token per backend, never browser code.
# capabilities omitted => ["catalog"] only.
# Add "catalog-health" explicitly only for backends allowed to read internal Catalog health.
# Health-only registrations are allowed and do not gain catalog data access.
# F01/F86/Admin require their own complete projections before registration is enabled.
# FREEPASS_DATA_CONSUMERS_JSON=[{"id":"erp-com","projectionId":"erp-public","token":"<unique-random-service-secret-at-least-32-characters>","capabilities":["catalog"]}]
# Example explicit health scope:
# FREEPASS_DATA_CONSUMERS_JSON=[{"id":"erp-com","projectionId":"erp-public","token":"<unique-random-service-secret-at-least-32-characters>","capabilities":["catalog","catalog-health"]}]

# Confirmed legacy source project binding from freepasserp4.
# Explicitly set this before a live read so the operator sees the boundary.
# LEGACY_FREEPASSERP3_PROJECT_ID=freepasserp3

# Credential must have only the permissions required for the selected operation.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
