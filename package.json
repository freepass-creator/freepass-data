{
  "name": "@freepass/data-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx scripts/run-memory.mjs api",
    "worker:memory": "node --import tsx scripts/run-memory.mjs worker",
    "ingest:legacy-products": "tsx src/jobs/ingest-legacy-products.ts",
    "pilot:check": "tsx src/jobs/check-read-pilot.ts",
    "data:catalog": "tsx src/jobs/query-data-catalog.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run check:arch && npm run check:sheets && npm run build && npm test",
    "check:sheets": "node --test tests/sheet-presentation.node.mjs tests/sheet-presentation-online.node.mjs",
    "sheets:plan": "node scripts/sheet-presentation.mjs",
    "check:arch": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "fastify": "^5.0.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
