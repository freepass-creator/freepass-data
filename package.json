{
  "name": "@freepass/data-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "FREEPASS_DATA_DRIVER=memory tsx src/api/server.ts",
    "worker:memory": "FREEPASS_DATA_DRIVER=memory tsx src/worker.ts",
    "ingest:legacy-products": "tsx src/jobs/ingest-legacy-products.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run check:arch && npm run build && npm test",
    "check:arch": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "fastify": "^5.0.0",
    "firebase-admin": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
